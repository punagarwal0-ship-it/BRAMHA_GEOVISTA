# ==============================================================================
# GEOVISTA Intelligence ML Backend - Environment Configuration Example
# Copy this file to `.env` and fill in your credentials.
# Never commit `.env` to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# NASA Earthdata Credentials (https://urs.earthdata.nasa.gov/)
# Required for MODIS, HLS, Landsat, and other CMR-searchable products.
# ------------------------------------------------------------------------------
NASA_EARTHDATA_USERNAME=your_earthdata_username
NASA_EARTHDATA_PASSWORD=your_earthdata_password

# Bearer-token alternative (generate at https://urs.earthdata.nasa.gov/profile)
# When set, this takes precedence over username/password for HTTP auth.
EARTHDATA_TOKEN=

# ------------------------------------------------------------------------------
# ASF (Alaska Satellite Facility) Credentials
# Required for Sentinel-1, UAVSAR, ALOS, and RCM data via ASF Vertex.
# Same Earthdata credentials usually work – set separately if different.
# ------------------------------------------------------------------------------
ASF_USERNAME=your_asf_username
ASF_PASSWORD=your_asf_password

# ------------------------------------------------------------------------------
# API Server
# ------------------------------------------------------------------------------
GEOVISTA_API_HOST=0.0.0.0
GEOVISTA_API_PORT=8000

# Comma-separated list of allowed CORS origins (no trailing slashes)
GEOVISTA_CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000

# ------------------------------------------------------------------------------
# Storage Paths
# Leave blank to use OS defaults (temp dir / backend/artifacts)
# ------------------------------------------------------------------------------
# Directory for temporary/scratch files during processing
GEOVISTA_SCRATCH_DIR=

# Directory where processed artifacts, models, and results are saved
GEOVISTA_ARTIFACTS_DIR=

# ------------------------------------------------------------------------------
# Logging
# Options: DEBUG | INFO | WARNING | ERROR | CRITICAL
# ------------------------------------------------------------------------------
GEOVISTA_LOG_LEVEL=INFO

# ------------------------------------------------------------------------------
# MLflow Experiment Tracking
# file:./mlruns   -> local filesystem
# http://host:5000 -> remote MLflow server
# mlflow+databricks:// -> Databricks hosted
# ------------------------------------------------------------------------------
MLFLOW_TRACKING_URI=file:./mlruns

# ------------------------------------------------------------------------------
# GPU / CUDA Settings
# Leave blank to use all available GPUs.
# Set to "" or "none" to force CPU-only mode.
# Examples: "0", "0,1", "1"
# ------------------------------------------------------------------------------
CUDA_VISIBLE_DEVICES=0
